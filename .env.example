# =============================================================
# DaleVenta — Environment Variables
# Copy this file to .env and fill in the values for your environment
# NEVER commit .env to git (it contains secrets)
# =============================================================

# ----- Database (PostgreSQL) -----
DB_NAME=dalventa
DB_USER=dalventa
DB_PASSWORD=changeme

# ----- JWT Authentication -----
# Must be at least 256 bits (32+ characters). Change this to a secure random value in production.
JWT_SECRET=change-this-to-a-256-bit-secret-in-production
JWT_EXPIRATION_HOURS=24

# ----- CORS -----
# Comma-separated list of origins allowed to make requests to this API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Reverse proxy (infra/docker-compose.yml) -----
# Host port the nginx proxy binds to. Change if 80 is already in use locally.
PROXY_PORT=80
