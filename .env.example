# =============================================================
# DaleVenta — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# =============================================================

# ----- Database (PostgreSQL) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dalventa
DB_USER=dalventa
DB_PASSWORD=changeme

# ----- JWT -----
# Must be at least 256 bits (32 characters). Change in production.
JWT_SECRET=change-this-to-a-256-bit-secret-minimum-32-chars
JWT_EXPIRATION_HOURS=24

# ----- Cloudflare R2 (file storage for vehicle photos) -----
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dalventa-media
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Public URL for serving uploaded files
R2_PUBLIC_URL=https://media.dalventa.rd

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----- Next.js -----
NEXT_PUBLIC_API_URL=http://localhost:8080

# ----- pgAdmin (optional, only used with --profile tools) -----
PGADMIN_EMAIL=admin@dalventa.rd
PGADMIN_PASSWORD=admin

# ----- WhatsApp Business API (Phase 4) -----
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
